# Copy this file to `.env` and set SUPPORT_LLM_MODEL to enable the LLM
# reasoner. If SUPPORT_LLM_MODEL is unset, the system uses the offline
# rule-based reasoner instead (no key, no network).

# A litellm model string. Examples:
#   OpenAI:          gpt-4o-mini
#   Anthropic:       anthropic/claude-3-5-haiku-latest
#   Groq:            groq/llama-3.1-8b-instant
#   Local Ollama:    ollama/llama3.1
#   OpenAI-compat.:  openai/<your-model>        (set SUPPORT_LLM_API_BASE too)
SUPPORT_LLM_MODEL=

# Optional: custom endpoint for OpenAI-compatible / local servers.
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
SUPPORT_LLM_API_BASE=

# Optional: API key for the provider/proxy. Native providers (OpenAI,
# Anthropic, ...) also read their own standard env vars if you prefer.
SUPPORT_LLM_API_KEY=
